<?xml version="1.0" encoding="UTF-8"?>
<!--
  Versión en Java del motor, para comparar rendimiento con la versión en Rust.
  Misma arquitectura hexagonal: un módulo por capa, con las dependencias hacia adentro.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>sched</groupId>
    <artifactId>sched-engine</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>domain</module>
        <module>solver</module>
        <module>application</module>
        <module>proto</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <grpc.version>1.84.0</grpc.version>
        <protobuf.version>4.36.2</protobuf.version>
        <jnats.version>2.26.3</jnats.version>
        <jmh.version>1.37</jmh.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Módulos internos -->
            <dependency><groupId>sched</groupId><artifactId>sched-domain</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-solver</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-application</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-proto</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-adapter-in-memory</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-adapter-grpc-catalog</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-adapter-grpc-events</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-adapter-nats-bus</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>sched</groupId><artifactId>sched-adapter-gateway-http</artifactId><version>${project.version}</version></dependency>

            <!-- Externos -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>io.nats</groupId>
                <artifactId>jnats</artifactId>
                <version>${jnats.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
