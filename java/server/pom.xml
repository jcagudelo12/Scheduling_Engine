<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>sched</groupId>
        <artifactId>sched-engine</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>sched-server</artifactId>
    <description>Aplicación Spring Boot: instancia los adaptadores y los inyecta en los casos de uso.</description>

    <dependencies>
        <dependency><groupId>sched</groupId><artifactId>sched-application</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-solver</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-adapter-gateway-http</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-adapter-grpc-catalog</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-adapter-grpc-events</artifactId></dependency>
        <dependency><groupId>sched</groupId><artifactId>sched-adapter-nats-bus</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
        <dependency><groupId>io.nats</groupId><artifactId>jnats</artifactId></dependency>
        <dependency><groupId>io.grpc</groupId><artifactId>grpc-netty-shaded</artifactId></dependency>
    </dependencies>

    <build>
        <finalName>sched-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
